{
  "name": "winged-horse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "pnpm --filter './packages/**' build",
    "pretest": "pnpm --filter './packages/**' build",
    "dev": "concurrently -n web,api -c yellow,blue \"pnpm --filter @wingedhorse/web dev\" \"pnpm --filter @wingedhorse/api dev\"",
    "dev:web": "pnpm --filter @wingedhorse/web dev",
    "dev:api": "pnpm --filter @wingedhorse/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @wingedhorse/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
