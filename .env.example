# WingedHorse 环境变量模板（示例，不含真实密钥）
# 复制为 .env 用于本地开发；生产使用 deploy/.env.production.example 模板。

# --- 通用 ---
NODE_ENV=development

# --- 本地开发端口 ---
WEB_PORT=5173
API_PORT=3100

# --- 本地依赖（开发用 Docker Compose 提供） ---
DATABASE_URL=postgresql://wingedhorse:wingedhorse@localhost:5432/wingedhorse
REDIS_URL=redis://localhost:6379

# --- OpenRouter（仅服务端，禁止进入前端/Git/日志） ---
# Model Policy（见 docs/TECHNICAL_ARCHITECTURE.md §3）：chat/summary/vision 按任务选模型
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=deepseek/deepseek-chat
OPENROUTER_SUMMARY_MODEL=deepseek/deepseek-chat
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-30b-a3b-thinking
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=20000

# --- Web 构建期开关（Vite 只注入 VITE_ 前缀变量；改动需重新 build） ---
# 端侧镜头/表情实验：开发环境可用，生产构建默认关闭；专项复核后显式开启
# VITE_FEATURE_CAMERA_SIGNALS=true
# rPPG 趣味脉搏趋势：默认关闭；仅在完成专项复核的内测构建中显式开启
# VITE_FEATURE_RPPG=true

# --- 生产环境（docker-compose.prod.yml 使用，本地开发可忽略） ---
# 生产数据库账号（compose 内 postgres 服务与 DATABASE_URL 都引用）
POSTGRES_DB=wingedhorse
POSTGRES_USER=wingedhorse
POSTGRES_PASSWORD=请替换为随机长密码
# 备案后的 HTTPS 访问地址，用于 OpenRouter HTTP-Referer
PUBLIC_APP_URL=https://your-domain.example.com

# --- MQTT（设备联动，可选；未配置时 API 优雅降级） ---
MQTT_URL=
MQTT_USER=
MQTT_PASSWORD=
