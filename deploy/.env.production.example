# WingedHorse 生产环境变量模板
#
# 使用方式：复制到服务器 /opt/wingedhorse/manual/.env.production 并填写真实值。
# 该文件本身不含任何真实密钥，可以提交到 Git；真实的 .env.production 永不提交。
#
# 注意：docker-compose.prod.yml 通过 env_file 引用 ../.env.production，
#       API 通过 ${POSTGRES_USER}/${POSTGRES_PASSWORD}/${POSTGRES_DB} 注入连接串。

NODE_ENV=production
API_PORT=3100

# --- PostgreSQL（生产 compose 内服务） ---
POSTGRES_DB=wingedhorse
POSTGRES_USER=wingedhorse
POSTGRES_PASSWORD=请替换为随机生成的长密码（如 openssl rand -base64 32）

# --- Redis（多实例限流、并发锁与 UTC 日预算） ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=请替换为随机生成的长密码
# 用于把 IP/会话标识转为不可逆 HMAC；至少 32 字符，各 API 实例必须完全一致
COMPANION_FINGERPRINT_SECRET=请替换为随机生成的至少32字符密钥

# --- OpenRouter（仅服务端） ---
# Model Policy：chat/summary/vision 按任务选模型；高风险分类走本地规则（SafetyService），不调模型
OPENROUTER_API_KEY=请替换为真实密钥
OPENROUTER_CHAT_MODEL=deepseek/deepseek-chat
OPENROUTER_SUMMARY_MODEL=deepseek/deepseek-chat
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-30b-a3b-thinking
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=20000

# --- Agent 应用层限流与模型预算（Redis 原子计数，UTC 自然日） ---
COMPANION_IP_RATE_LIMIT_PER_MINUTE=60
COMPANION_SESSION_RATE_LIMIT_PER_MINUTE=20
COMPANION_SESSION_MODEL_BUDGET_PER_DAY=40
COMPANION_GLOBAL_MODEL_BUDGET_PER_DAY=1000

# --- 公网与功能开关 ---
PUBLIC_APP_URL=https://your-domain.example.com
# 仅作为 Docker 构建参数使用；默认 false。专项合规复核后才可改为 true 并重新构建 Web 镜像。
VITE_FEATURE_CAMERA_SIGNALS=false
VITE_FEATURE_RPPG=false

# --- MQTT（设备联动） ---
# 服务端连接 broker 的账号（broker ACL 里对应 wingedhorse 用户）
MQTT_URL=mqtt://mosquitto:1883
MQTT_USER=wingedhorse
MQTT_PASSWORD=请替换为随机生成的长密码
