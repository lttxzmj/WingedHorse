# syntax=docker/dockerfile:1

FROM node:24-alpine AS build

ARG VITE_FEATURE_CAMERA_SIGNALS=false
ARG VITE_FEATURE_RPPG=false
ENV VITE_FEATURE_CAMERA_SIGNALS=$VITE_FEATURE_CAMERA_SIGNALS
ENV VITE_FEATURE_RPPG=$VITE_FEATURE_RPPG
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @wingedhorse/domain build \
 && pnpm --filter @wingedhorse/contracts build \
 && pnpm --filter @wingedhorse/ui build \
 && pnpm --filter @wingedhorse/character-runtime build \
 && pnpm --filter @wingedhorse/web build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080 8443
